# fastscan deployment configuration.
#
# install.sh copies this to fastscan.env on first run and fills UI_PASS with
# a random value. Edit fastscan.env (NOT this file) to change settings, then:
#   ./install.sh --restart-ui   - apply a new UI password
#   ./install.sh                - full rebuild + restart

# --- Web UI login ---
UI_USER=admin
UI_PASS=CHANGE_ME

# Address the UI listens on (host:port). 0.0.0.0 exposes it on all interfaces.
UI_ADDR=0.0.0.0:8888

# --- Screenshots (optional) ---
# Path to a vncpasswd-encoded file. When set, scans launched from the UI can
# capture VNC screenshots of password-protected servers. Create one with:
#   printf 'yourpass\nyourpass\n' | vncpasswd /path/to/vnc.pw
# Leave empty to only screenshot no-auth VNC servers.
VNC_PASSWD_FILE=
