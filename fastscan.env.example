# fastscan deployment configuration.
#
# On first run, install.sh copies this file to fastscan.env and fills UI_PASS
# with a random value. Edit fastscan.env (NOT this example) to change settings,
# then re-run "./install.sh --restart-ui" to apply a new UI password, or
# "./install.sh" for a full rebuild.

# --- Engine ---
# Directory the engine binary is built into (binary path is $ENGINE_BIN_DIR/fastscan).
ENGINE_BIN_DIR=/tmp/fastscan

# --- Web UI ---
# Login for the web UI. Change UI_PASS here and run "./install.sh --restart-ui".
UI_USER=admin
UI_PASS=CHANGE_ME

# Address the UI listens on (host:port). 0.0.0.0 exposes it on all interfaces.
UI_ADDR=0.0.0.0:8888

# Persistent data directory for scans/results.
UI_DATA_DIR=/root/fastscan-ui-data

# UI source tree (server/ + web/). If absent, the UI steps are skipped and only
# the engine is installed.
UI_SRC_DIR=/tmp/fastscan-ui

# --- Screenshots (optional) ---
# Path to a vncpasswd-encoded file. When set, scans launched from the UI can
# capture VNC screenshots of password-protected servers. Create one with:
#   printf 'yourpass\nyourpass\n' | vncpasswd /root/fastscan/vnc.pw
# Leave empty to only screenshot no-auth VNC servers.
VNC_PASSWD_FILE=
